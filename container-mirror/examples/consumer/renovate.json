{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump every reference in images.txt and charts.txt, tag and digest together. A Helm chart on an OCI registry is looked up as a docker package.",
      "fileMatch": [
        "^images\\.txt$",
        "^charts\\.txt$"
      ],
      "matchStrings": [
        "^(?<depName>[^\\s#:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?\\s*$"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump the shared CI tag the pipeline is included at.",
      "fileMatch": [
        "^\\.gitlab-ci\\.yml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*ref:\\s*'(?<currentValue>[^']+)'"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "images.txt"
      ],
      "commitMessageTopic": "mirrored image {{depName}}",
      "labels": [
        "container-mirror"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts.txt"
      ],
      "commitMessageTopic": "mirrored chart {{depName}}",
      "labels": [
        "container-mirror"
      ]
    }
  ]
}
