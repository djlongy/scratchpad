# Local run of the wiki sync:  cp .env.example .env; edit; source .env; scripts/wiki-deploy.sh docs wiki
# .env and wiki/ are gitignored. Never commit a token.
GITLAB_HOST=gitlab.example.com
GITLAB_PROJECT_PATH=group/project
CI_DEFAULT_BRANCH=main
# project access token, role Developer or higher, scope write_repository
WIKI_TOKEN=
# optional
# DRY_RUN=1
# MKDOCS_CONFIG=mkdocs.yml
