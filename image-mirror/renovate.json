{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the RKE2 release the image mirror fetches image lists for.",
      "fileMatch": [
        "^image-mirror/rke2\\.yaml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s*\\nversion:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "rancher/rke2"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "commitMessageTopic": "RKE2 image set",
      "labels": [
        "image-mirror"
      ]
    }
  ]
}
