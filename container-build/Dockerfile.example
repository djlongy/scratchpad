# ─── TEMPLATE — copy to Dockerfile ─────────────────────────────────
# First-time setup:  cp Dockerfile.example Dockerfile
# Edit ONLY the marked "FORK EDITS GO HERE" region in your copy. The
# base and the cert sidecar are template logic — leave them.
# Dynamic OCI labels (version, revision, created, base.digest, source)
# are added by scripts/build.sh via `docker build --label`, not here.
# ───────────────────────────────────────────────────────────────────
#
# Build shape:
#   upstream base → cert sidecar (shell-bearing builder, so it works
#   on distroless / chainguard / scratch too) → final stage re-bases
#   FROM base → editable region. The template emits no USER line, so
#   the image runs as whatever user the upstream configured.

# ── Global ARGs ──────────────────────────────────────────────────────
# build.sh passes these via --build-arg from image.env. The defaults
# below only apply if someone runs `docker build .` directly without
# the script.
ARG UPSTREAM_REGISTRY=docker.io/library
ARG UPSTREAM_IMAGE=nginx
ARG UPSTREAM_TAG=1.29.8-alpine
# UPSTREAM_REF = the base as ONE full URL, carrying the digest. It is
# THE reference the template builds from: build.sh resolves the tag to
# a manifest digest once and passes registry/image:tag@sha256:… here,
# so this FROM, the base inspection, the USER lookup and the OCI labels
# all name the same bytes. The three parts above are kept for forks
# that read them — don't FROM them, they have no digest.
ARG UPSTREAM_REF=docker.io/library/nginx:1.29.8-alpine
ARG CERT_BUILDER_IMAGE=docker.io/library/alpine:3.20

# ── Upstream base ────────────────────────────────────────────────────
FROM ${UPSTREAM_REF} AS base

# ── Cert sidecar (shell-bearing builder) ─────────────────────────────
# Runs in a SEPARATE image so cert prep works regardless of whether
# the upstream base has a shell (chainguard FIPS, distroless static,
# scratch). Produces an updated trust store = alpine system roots +
# the corp CAs in certs/. The final stage COPYs the files over.
#
# Trade-off: the final stage COPYs these files over the upstream's, so
# the upstream's /etc/ssl/certs/ca-certificates.crt and /etc/ssl/cert.pem
# are REPLACED by alpine's bundle plus whatever is in certs/. That
# happens with an EMPTY certs/ too — the sidecar has nothing to inject,
# but the replacement still runs. Alpine's bundle is the Mozilla CA
# list, so for most images the swap is equivalent. It is not equivalent
# for an image whose trust store was curated or FIPS-restricted: that
# curation is lost. Fork this Dockerfile there.
#
# Only the OpenSSL-style bundle is touched. A Java cacerts keystore,
# Node's compiled-in roots and Python's certifi carry their own trust
# stores; they are left exactly as the upstream shipped them, so an
# image that reads one of those never sees certs/.
#
# build.sh pins this the same way it pins UPSTREAM_REF — the value that
# arrives here carries an @sha256 digest. The ARG default above is the
# unpinned fallback for a direct `docker build .`.
FROM ${CERT_BUILDER_IMAGE} AS certs-source
USER root

# Two vendored shell scripts (next to this Dockerfile in every per-
# image repo). Extracted from inline RUN so SonarQube / shellcheck
# can scan the bash. Anyone who runs `docker build .` directly gets
# a working build because every COPY source is in `ls`.
#   install-ca-certificates.sh  best-effort install of ca-certificates
#                               (skipped if rebuild tool already present)
#   inject-certs.sh             cat-append corp CA into the trust bundle
COPY install-ca-certificates.sh /tmp/install-ca-certificates.sh
COPY inject-certs.sh            /tmp/inject-certs.sh
COPY certs/                     /tmp/certs/

RUN /tmp/install-ca-certificates.sh \
 && /tmp/inject-certs.sh \
 && rm -f /tmp/install-ca-certificates.sh /tmp/inject-certs.sh

# ── Final image ──────────────────────────────────────────────────────
# Re-bases FROM base so USER stays whatever upstream had. COPY --from
# pulls the prepared trust files out of the builder. Pure file ops —
# no RUN below this point until the editable region, so this works
# for shell-less bases.
FROM base AS final
COPY --from=certs-source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=certs-source /etc/ssl/cert.pem                  /etc/ssl/cert.pem
COPY --from=certs-source /usr/local/share/ca-certificates   /usr/local/share/ca-certificates
COPY --from=certs-source /etc/pki/ca-trust/source/anchors   /etc/pki/ca-trust/source/anchors

# ═══════════════════════════════════════════════════════════════════
# ▼▼▼  FORK EDITS GO HERE  ▼▼▼
# ═══════════════════════════════════════════════════════════════════
# Bespoke per-image work: package upgrades, extra installs, config
# drops, HEALTHCHECK, ENV.
#
# Shell-less bases (chainguard FIPS, distroless static, scratch) can't
# RUN anything — leave this region EMPTY for those. Cert COPYs above
# are pure file ops and still work.
#
# An empty region — or one holding only COPY / ENV / HEALTHCHECK —
# keeps the base image's user, because nothing below emits a USER line.
#
# A RUN that needs write permissions has to enter root, and then it has
# to come back. Do both of these together:
#   - uncomment the `USER root` … `USER ${ORIGINAL_USER}` pair below
#   - set RESTORE_USER=true in image.env
# RESTORE_USER is the one knob. It makes build.sh resolve ORIGINAL_USER
# (an explicit value wins, else `crane config` on the pinned base) and
# FAIL when it cannot resolve one — an image that entered root must
# never stay there because a lookup quietly failed.
#
# Common patterns (uncomment what you need):
#
#   USER root
#   # CVE remediation — pick the line that matches your upstream distro
#   RUN apk update && apk upgrade --no-cache
#   # RUN apt-get update && apt-get -y --only-upgrade upgrade && rm -rf /var/lib/apt/lists/*
#   # RUN microdnf -y update && microdnf clean all
#
#   # Extra packages
#   # RUN apk add --no-cache curl jq
#
#   # Static config
#   # COPY config/nginx.conf /etc/nginx/nginx.conf
#
#   # Health check
#   # HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ || exit 1
#
#   # Back to the upstream's user, last line of the region. Pair it
#   # with RESTORE_USER=true in image.env — build.sh only resolves
#   # ORIGINAL_USER when that is set.
#   ARG ORIGINAL_USER
#   USER ${ORIGINAL_USER}
#
# Keep edits minimal. If your image needs hundreds of lines of bespoke
# logic, fork the template and own it.
# ═══════════════════════════════════════════════════════════════════
# ▲▲▲  END FORK EDITS  ▲▲▲
# ═══════════════════════════════════════════════════════════════════

# No USER line below this point, deliberately. A Dockerfile cannot emit
# one conditionally, and a template that always emitted `USER root` as
# its fallback would turn every non-root upstream into a root image.
# The final stage re-bases FROM base, so the image keeps the upstream's
# user; a fork that enters root restores it inside the region above.
