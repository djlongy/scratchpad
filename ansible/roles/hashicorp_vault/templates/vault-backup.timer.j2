[Unit]
Description=Vault Raft snapshot backup (4-hourly, RPO=4h)
Documentation=https://developer.hashicorp.com/vault/docs/commands/operator/raft

[Timer]
# Run every 4 hours — snapshots complete in seconds, only leader runs
OnCalendar=*-*-* 00/4:00:00
# Run on next opportunity if system was off during scheduled time
Persistent=true

[Install]
WantedBy=timers.target
