# svc-rundeck-keystore — Rundeck Key Storage backend AppRole
# WHO:     svc-rundeck-keystore (AppRole)
# WHERE:   rundeck-01 container, loaded by the HashiCorp Vault
#          Storage Backend plugin (replaces Rundeck's local-DB key storage).
# TTL:     8h / 24h max. secret_id is long-lived (1 year) because rotating
#          it requires a Rundeck restart, unlike the per-env AppRoles which
#          re-login on every job dispatch.
# Managed by: ansible/roles/hashicorp_vault — DO NOT edit manually.
#
# Scope: full CRUD on a single dedicated path — kv-mgmt/rundeck-keystore/*.
# This is intentionally separate from kv-mgmt/apps/*, kv-mgmt/platform/*,
# kv-mgmt/ops/* — the plugin OWNS this subtree and operators write to it
# via Rundeck's UI, NOT via `vault kv put` directly. The path layout in
# Vault mirrors the Rundeck Key Storage tree:
#   kv-mgmt/data/rundeck-keystore/test/api-token   ↔  /keys/test/api-token in UI
#   kv-mgmt/data/rundeck-keystore/job-X/ssh-key    ↔  /keys/job-X/ssh-key  in UI
#
# Why not reuse svc-rundeck-mgt: that role rotates secret_id on every deploy.
# Rotating the keystore AppRole's secret_id would lock Rundeck out of all
# its stored keys until the next rundeck apply — bad operationally.

# Full CRUD on the keystore subtree
path "kv-mgmt/data/rundeck-keystore/*" {
  capabilities = ["create", "read", "update", "delete", "patch", "list"]
}
path "kv-mgmt/metadata/rundeck-keystore/*" {
  capabilities = ["read", "delete", "list"]
}
path "kv-mgmt/metadata/rundeck-keystore" {
  capabilities = ["list"]
}

# Plugin needs to introspect the KV mount to detect engine version (v2)
path "sys/mounts" {
  capabilities = ["read"]
}
path "sys/internal/ui/mounts/kv-mgmt" {
  capabilities = ["read"]
}

# Token self-management — for renewal mid-session
path "auth/token/lookup-self" {
  capabilities = ["read"]
}
path "auth/token/renew-self" {
  capabilities = ["update"]
}
