# svc-rundeck-dev — Rundeck dev-project AppRole
# WHO:     svc-rundeck-dev (AppRole)
# WHERE:   dev Rundeck project
# TTL:     8h / 24h max
# Managed by: ansible/roles/hashicorp_vault — DO NOT edit manually.
#
# Scope: read-only KV access to kv-dev/* only. Write narrow on
# kv-dev/apps/+/runtime. NO access to kv-mgmt or kv-prod. Env isolation
# enforced at the Vault policy layer.

# Read-only KV access — dev mount only
path "kv-dev/data/*"        { capabilities = ["read", "list"] }
path "kv-dev/metadata/*"    { capabilities = ["read", "list"] }

# Write on dev apps/*/runtime — for token caches, refreshable creds, etc.
path "kv-dev/data/apps/+/runtime"    { capabilities = ["create", "update", "patch", "read"] }

# Token self-management
path "auth/token/create" {
  capabilities = ["create", "update"]
}
path "auth/token/lookup-self" {
  capabilities = ["read"]
}
path "auth/token/renew-self" {
  capabilities = ["update"]
}
