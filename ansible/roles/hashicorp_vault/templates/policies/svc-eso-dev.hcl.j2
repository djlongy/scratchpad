# svc-eso-dev — External Secrets Operator read policy (dev environment)
# WHO:     ESO via Kubernetes auth (external-secrets ServiceAccount in external-secrets ns)
# TTL:     1h token, renewable, max 24h
# Managed by: ansible/roles/hashicorp_vault — DO NOT edit manually.
#
# Scope: read-only, scoped to kv-dev platform/app/common paths.
# Segregated from prod — a compromised dev container cannot read prod secrets.

# kv-dev — platform and app runtime secrets (no deploy/ or ops/ scope)
path "kv-dev/data/platform/*" {
  capabilities = ["read"]
}
path "kv-dev/metadata/platform/*" {
  capabilities = ["read", "list"]
}
path "kv-dev/data/apps/*" {
  capabilities = ["read"]
}
path "kv-dev/metadata/apps/*" {
  capabilities = ["read", "list"]
}
path "kv-dev/data/common/*" {
  capabilities = ["read"]
}
path "kv-dev/metadata/common/*" {
  capabilities = ["read", "list"]
}

# UI / CLI preflight
path "sys/internal/ui/mounts/kv/*" {
  capabilities = ["read"]
}
path "sys/internal/ui/mounts" {
  capabilities = ["read"]
}

# Token self-management
path "auth/token/lookup-self" {
  capabilities = ["read"]
}
path "auth/token/renew-self" {
  capabilities = ["update"]
}
