[Unit]
Description=Vault Raft snapshot backup
After=network-online.target vault.service
Requires=vault.service
Documentation=https://developer.hashicorp.com/vault/docs/commands/operator/raft

[Service]
Type=oneshot
ExecStart={{ vault_backup_script_path }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-backup

# Run as root with vault group for cert/key access
User=root
Group=vault

# Security hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ vault_backup_dir }} {{ vault_host_data_dir }}/keys /var/log /var/lib/node_exporter

[Install]
WantedBy=multi-user.target
