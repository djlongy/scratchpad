<?xml version="1.0" encoding="utf-8"?>
{#
  Generic firewalld zone XML template.

  Sources and interfaces are merged from BOTH:
    - item.sources / item.interfaces on the zone dict
    - firewalld_source_zone_bindings / firewalld_interface_zone_bindings
      whose zone matches item.name

  They MUST live in this permanent XML. Runtime-only
  `firewall-cmd --permanent --add-source` writes into the same file; if we
  re-template without those elements, the next --reload wipes them and
  traffic falls to the default zone (drop) — live SSH lockout.
#}
{%- set _bind_sources = firewalld_source_zone_bindings
      | default([])
      | selectattr('zone', 'defined')
      | selectattr('zone', 'equalto', item.name)
      | map(attribute='source')
      | list -%}
{%- set _all_sources = (item.sources | default([]) + _bind_sources) | unique | list -%}
{%- set _bind_ifaces = firewalld_interface_zone_bindings
      | default([])
      | selectattr('zone', 'defined')
      | selectattr('zone', 'equalto', item.name)
      | map(attribute='interface')
      | list -%}
{%- set _all_ifaces = (item.interfaces | default([]) + _bind_ifaces) | unique | list -%}
<zone{% if item.target | default('default') != 'default' %} target="{{ item.target }}"{% endif %}>
{% if item.short is defined and item.short | length > 0 %}
  <short>{{ item.short }}</short>
{% endif %}
{% if item.description is defined and item.description | length > 0 %}
  <description>{{ item.description }}</description>
{% endif %}
{% for iface in _all_ifaces %}
  <interface name="{{ iface }}"/>
{% endfor %}
{% for src in _all_sources %}
  <source address="{{ src }}"/>
{% endfor %}
{% for svc in item.services | default([]) %}
  <service name="{{ svc }}"/>
{% endfor %}
{% for p in item.ports | default([]) %}
  <port port="{{ p.port }}" protocol="{{ p.protocol }}"/>
{% endfor %}
{% for proto in item.protocols | default([]) %}
  <protocol value="{{ proto }}"/>
{% endfor %}
{% for sp in item.source_ports | default([]) %}
  <source-port port="{{ sp.port }}" protocol="{{ sp.protocol }}"/>
{% endfor %}
{% for icmp in item.icmp_blocks | default([]) %}
  <icmp-block name="{{ icmp }}"/>
{% endfor %}
{% if item.icmp_block_inversion | default(false) %}
  <icmp-block-inversion/>
{% endif %}
{% if item.masquerade | default(false) %}
  <masquerade/>
{% endif %}
{% if item.forward | default(false) %}
  <forward/>
{% endif %}
{% for rule in item.rich_rules | default([]) %}
  <rule>{{ rule }}</rule>
{% endfor %}
</zone>
