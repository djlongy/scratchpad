---
# {{ certificate_authority_bootstrap_file | basename }} — GENERATED by the certificate_authority
# role's bootstrap phase (--tags bootstrap, mode: {{ _ca_bootstrap_mode }}). Do not edit by hand.
#
# Root CA in CONTENT mode (ADR-0014): the certificate is public; the private key is an
# inline Ansible-Vault value encrypted with the SAME vault password as the rest of the
# estate (env ANSIBLE_VAULT_PASSWORD or --ask-vault-pass both unlock it). While this
# file loads, root generation is skipped and signing happens in memory — the declared
# intermediate/wildcard tiers must stay empty (content-mode scope guard).
#
# Root CN: {{ certificate_authority_root.common_name }}
{% if _ca_bootstrap_mode == 'import' %}
# Source: imported from {{ certificate_authority_pki_dir }}/root/ — the certificate is
# UNCHANGED (no trust-anchor rotation).
{% if _ca_bootstrap_key_is_encrypted %}
# The key remains passphrase-encrypted PKCS#8: certificate_authority_root_key_passphrase
# must STAY wired (Ansible Vault + passphrase are two independent at-rest layers).
{% endif %}
{% else %}
# Source: freshly generated in memory. The key is PASSWORDLESS — this file's Ansible
# Vault encryption is the single at-rest layer; no root passphrase var is needed.
{% endif %}
#
# Re-mint: delete this file, then re-run --tags bootstrap (fail-closed while it exists).

certificate_authority_root_cert_content: |
{{ _ca_bootstrap_cert_pem | trim | indent(2, true) }}

certificate_authority_root_key_content: !vault |
{{ _ca_bootstrap_key_vaulted | trim | indent(2, true) }}
