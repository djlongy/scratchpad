---
# ─────────────────────────────────────────────────────────────────────
# EXAMPLE secrets for the vault inventory group.
# Rename to vault.yml and encrypt:
#   ansible-vault encrypt inventories/vault/group_vars/vault/vault.yml
#
# Variable names match hashicorp_vault_container (not the old vault_* prefix).
# ─────────────────────────────────────────────────────────────────────

# FreeIPA bind password for Path A LDAP (required when ldap_enabled: true).
# Prefer a dedicated service account (uid=svc-vault), not directory admin.
hashicorp_vault_ldap_bindpass: "REPLACE-ME-with-FreeIPA-bind-password"

# Optional break-glass userpass (only if you add hashicorp_vault_userpass_accounts
# in main.yml). Example add-on:
#   - {username: alice, password: "{{ vaulted_alice_pw }}", policies: [default, vault-admin]}
# vaulted_alice_pw: "REPLACE-ME-strong-break-glass-passphrase"
