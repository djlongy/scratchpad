# ── Browser-automation / agent tool artifacts ─────────────────────────────────────
.playwright-cli/
ansible/_trial-backup/

# Daemon-agent chaos-test findings handoff (not tracked)
CHAOS-FINDINGS.md

# Live-instance config exports / backups from role testing (contain real config)
ansible/trial-backups/
ansible/artifactory-as-built*.yml
# Captured Artifactory As-Built state — per-env (real hostnames/DNs/emails/XML).
# Defence-in-depth alongside roles/artifactory/files/state/.gitignore.
**/files/state/*/artifactory.*
# Ansible inventory local overrides (real hostnames/URLs/secrets — never commit).
ansible/inventories/**/local.yml
# FreeIPA config snapshots from `--tags export` (real usernames/emails — rename
# into group_vars deliberately if you want to commit one)
**/freeipa.config.snapshot.yml

# Local planning artifacts — never publish prompts/plans/specs
docs/superpowers/

# Live FreeIPA export snapshots — REAL realm data, never commit to public repo
*.live.yml
